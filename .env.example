# Copy this file to .env and fill in values. Never commit .env.

PORT=3000

# Needed from Stage 2 onward (get one at https://aistudio.google.com/apikey). Server-side only.
GEMINI_API_KEY=

# Model used for function calling. Verify the current name in the official Gemini docs.
GEMINI_MODEL=gemini-3.1-flash-lite

# Where the demo "database" lives. Created from data/seed.json on first run.
DATA_FILE=data/runtime.json
